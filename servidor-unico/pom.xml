<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>br.com.vitrinebauru</groupId>
    <artifactId>vitrine-bauru</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>servidor-unico</artifactId>
  <name>Vitrine Bauru :: Servidor Unico</name>
  <description>Empacota os quatro servicos num processo so para a implantacao gratuita.</description>

  <dependencies>
    <dependency>
      <groupId>br.com.vitrinebauru</groupId>
      <artifactId>servico-cadastro</artifactId>
    </dependency>
    <dependency>
      <groupId>br.com.vitrinebauru</groupId>
      <artifactId>servico-catalogo</artifactId>
    </dependency>
    <dependency>
      <groupId>br.com.vitrinebauru</groupId>
      <artifactId>servico-busca</artifactId>
    </dependency>
    <dependency>
      <groupId>br.com.vitrinebauru</groupId>
      <artifactId>servico-notificacoes</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
    </dependency>
    <dependency>
      <groupId>io.zonky.test.postgres</groupId>
      <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
    </dependency>
    <dependency>
      <groupId>io.zonky.test.postgres</groupId>
      <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
          <!--
            Grava versão e horário da construção em build-info.properties, que
            o actuator publica em /actuator/info. Existe para responder "qual
            versão está no ar", que antes só dava para saber olhando o painel.

            Quem depende disso é o fluxo publicar-api.yml: depois de disparar
            o deploy, ele espera o horário publicado ficar mais novo que o do
            começo do fluxo. Sem isso o fluxo ficava verde na hora, porque a
            instância velha continua respondendo 200 enquanto a nova constrói.
          -->
          <execution>
            <id>informacao-da-construcao</id>
            <goals><goal>build-info</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
