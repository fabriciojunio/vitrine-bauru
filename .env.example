# Copie para .env e ajuste. O .env está no .gitignore e nunca deve ser commitado.

# ------------------------------------------------------------------ banco
BANCO_URL=jdbc:postgresql://localhost:5432/vitrine
BANCO_USUARIO=vitrine
BANCO_SENHA=vitrine
BANCO_MAXIMO_DE_CONEXOES=8

# ------------------------------------------------------- eventos e broker
# kafka (com broker) ou processo (tudo num processo so, sem broker)
TRANSPORTE_DE_EVENTOS=processo
KAFKA_SERVIDORES=localhost:9092

# -------------------------------------------------------------- seguranca
# Minimo de 32 bytes. Em producao, gere um valor aleatorio e nunca reaproveite.
VITRINE_SEGREDO_JWT=segredo-de-desenvolvimento-com-mais-de-32-bytes
ORIGENS_PERMITIDAS=http://localhost:5173
LIMITE_ATIVO=true

# ----------------------------------------------------------- demonstracao
# Liga um endereco que devolve sessao valida sem senha. Nunca em producao.
DEMO_ATIVO=false
DEMO_SENHA=demonstracao2026

# ---------------------------------------------------------------- e-mail
# Desligado: as mensagens vao para o log em vez de serem enviadas.
EMAIL_ATIVO=false
RESEND_CHAVE=
EMAIL_REMETENTE=Vitrine Bauru <nao-responda@vitrinebauru.com.br>

# ------------------------------------------------------ servicos externos
BRASILAPI_ATIVA=true

# --------------------------------------------------------------- servidor
PORTA=8080
